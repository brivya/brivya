{
  "name": "@brivya/cli",
  "version": "0.1.0-alpha.1",
  "description": "Local developer CLI for Brivya Business Agent manifests.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "brivya": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@brivya/manifest": "0.1.0-alpha.1",
    "@brivya/distribution": "0.1.0-alpha.1",
    "@brivya/adapter-workbuddy": "0.1.0-alpha.1",
    "@brivya/adapter-wechat-ai": "0.1.0-alpha.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
