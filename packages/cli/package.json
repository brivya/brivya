{
  "name": "@brivya/cli",
  "version": "0.1.0-alpha.1",
  "description": "Local-first developer CLI for Brivya.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "brivya": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": ["dist"],
  "dependencies": {
    "@brivya/sdk": "0.1.0-alpha.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
